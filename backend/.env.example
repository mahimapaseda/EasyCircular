PORT=4000
MONGODB_URI=mongodb://localhost:27017/easycircular
AI_SERVICE_URL=http://localhost:5000
UPLOAD_DIR=./uploads
JWT_SECRET=change-this-to-a-long-random-string
AI_SERVICE_TOKEN=easycircular-dev-ai-token
GOOGLE_CLIENT_ID=
# Google Identity (Web client). Same value as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# Authorized JavaScript origins must include http://localhost:3002
# powershell -File .\scripts\enable-google-signin.ps1 -ClientId "YOUR_ID.apps.googleusercontent.com"
PROCESS_RATE_LIMIT=10
# Comma-separated list of allowed origins (required in production)
CORS_ORIGINS=http://localhost:3002
