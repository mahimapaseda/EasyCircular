{
  "name": "easycircular",
  "version": "0.1.0",
  "private": true,
  "description": "EasyCircular monorepo",
  "scripts": {
    "verify:phase1": "node scripts/verify-phase1.mjs",
    "verify:phase4": "node scripts/verify-phase4.mjs",
    "evaluate:samples": "python scripts/evaluate-samples.py",
    "evaluate:rouge": "python scripts/evaluate_rouge.py",
    "start:local": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local.ps1",
    "start:ollama": "powershell -ExecutionPolicy Bypass -File ./scripts/start-ollama.ps1 -PullModel",
    "capture:screenshots": "python scripts/capture_screenshots.py",
    "generate:thesis": "python scripts/extract_contextual_figures.py && python scripts/generate_thesis.py",
    "generate:user-manual": "python scripts/generate_user_manual.py",
    "generate:poster": "python scripts/generate_poster.py"
  }
}
