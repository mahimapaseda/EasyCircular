PORT=5000
# LLM provider: openai | gemini | groq
LLM_PROVIDER=gemini
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
SPACY_MODEL=en_core_web_sm
OCR_LANGUAGES=sin+eng+tam
CHUNK_SIZE=8000
CHUNK_OVERLAP=600
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
MAP_REDUCE_THRESHOLD=10000
MAX_UPLOAD_MB=50
CORS_ORIGINS=*
