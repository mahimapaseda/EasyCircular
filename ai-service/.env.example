PORT=5000
# LLM provider: openai | gemini | groq | ollama
LLM_PROVIDER=ollama
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Local Ollama (no API key). Start with scripts/start-ollama.ps1
OLLAMA_BASE_URL=http://127.0.0.1:11434
# After QLoRA publish: OLLAMA_MODEL=easycircular:3b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SEC=300
# llama3.2 defaults to 2048 tokens of context and truncates JSON; 8192 fits one circular.
OLLAMA_NUM_CTX=8192
LLM_TEMPERATURE=0.2
SPACY_MODEL=en_core_web_sm
OCR_LANGUAGES=sin+eng+tam
CHUNK_SIZE=8000
CHUNK_OVERLAP=600
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
MAP_REDUCE_THRESHOLD=10000
MAX_UPLOAD_MB=50
# Optional local NLLB translator for EN→SI/TA (pip install -r requirements-mt.txt).
TRANSLATE_MODEL=facebook/nllb-200-distilled-600M
TRANSLATE_DEVICE=auto
# huggingface_hub 1.x Xet downloads can stall at 0 bytes on Windows.
HF_HUB_DISABLE_XET=1
CORS_ORIGINS=*
# Must match backend/.env AI_SERVICE_TOKEN. Required in production.
AI_SERVICE_TOKEN=easycircular-dev-ai-token
